{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "客户流失 API",
      "type": "debugpy",
      "request": "launch",
      "module": "telecom_churn.cli",
      "args": [
        "serve"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "固定小样本：命令行测试",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_cli.py",
        "-v",
        "-s"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
